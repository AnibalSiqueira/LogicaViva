@startuml LogicaViva_UseCases

skinparam ActorBorderColor #7F77DD
skinparam UseCaseBorderColor #7F77DD
skinparam UseCaseBackgroundColor #EEEDFE
skinparam ArrowColor #888780

left to right direction

actor Student
actor Teacher

rectangle "Lógica Viva" {

  usecase "Write pseudocode"           as UC1
  usecase "Execute pseudocode"         as UC2
  usecase "Compile pseudocode"         as UC3
  usecase "View execution result"      as UC4
  usecase "Convert to C/C++"          as UC5
  usecase "View converted code"        as UC6

  usecase "Create exercise"            as UC7
  usecase "Assign exercise to student" as UC8
  usecase "View student submissions"   as UC9
  usecase "Provide feedback"           as UC10

  UC2 .> UC3 : <<include>>
  UC3 .> UC4 : <<include>>
  UC5 .> UC6 : <<include>>
  UC9 <. UC10 : <<extend>>
}

Student --> UC1
Student --> UC2
Student --> UC5

Teacher --> UC7
Teacher --> UC8
Teacher --> UC9

@enduml